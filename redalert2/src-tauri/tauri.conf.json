{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Red Alert 2",
  "version": "0.1.0-beta.1",
  "identifier": "com.stillm8.redalert2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4000",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Red Alert 2",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "A cross-platform Red Alert 2 engine",
    "longDescription": "A TypeScript and WebGL reimplementation of Red Alert 2 and Yuri's Revenge with profile-driven compatibility for Mental Omega.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
